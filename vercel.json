{
  "buildCommand": "npm run build && (npm run seed:blue-rag:deploy || echo 'blue-rag seed skipped; retrieval falls back to the bundled corpus')",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "functions": {
    "app/api/treasury/trade/**/*": {
      "regions": ["arn1", "dub1"]
    },
    "app/api/treasury/trades/**/*": {
      "regions": ["arn1", "dub1"]
    },
    "app/api/treasury/markets/**/*": {
      "regions": ["arn1", "dub1"]
    }
  },
  "crons": [
    {
      "path": "/api/treasury/trade",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/voting/proposal/review-sweep",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/membership/reconcile",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/events/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/guides/revision-check",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/blue-memory-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reflections",
      "schedule": "0 12 * * *"
    }
  ]
}
